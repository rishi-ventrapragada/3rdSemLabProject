  usecase "Mark attendance\nfor a date" as UC7
  usecase "Enter internal /\nexternal marks" as UC8
  usecase "Compute total\nand grade" as UC9
  usecase "Record marks change\n(audit)" as UC10
  usecase "Manage students,\nfaculty, courses (CRUD)" as UC11
  usecase "Enroll student" as UC12
  usecase "Add timetable entry" as UC13
  usecase "Check teacher clash" as UC14
  usecase "Declare defaulters" as UC15
  usecase "View GPA report\nand marks audit" as UC16
  usecase "Run Java engine\nreports" as UC17
}

