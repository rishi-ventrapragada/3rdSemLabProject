# Shared MySQL connection settings, read by BOTH the Django portal and the Java engine.
# Copy to .env (git-ignored) and set your real password:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# Keep plain KEY=value lines: no quotes, no `export`, no inline comments (the Java parser is minimal).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus_db
DB_USER=root
DB_PASSWORD=your_password

# Optional Django-only settings (defaults shown). Uncomment to change.
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string   (required when DJANGO_DEBUG=False)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DEMO_PASSWORD=campus-demo-2026                   (DEMO ONLY: shared password for seed_demo_users)
# DJANGO_JAVA_BIN=java
# DJANGO_JAVA_ENGINE_JAR=java_engine/target/smart-campus-engine.jar
# DJANGO_JAVA_ENGINE_TIMEOUT=30
